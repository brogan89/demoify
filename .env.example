# ---------------------------------------------------------------------------
# Required — the core config the app needs to run.
# ---------------------------------------------------------------------------

# The app's database is the Cloudflare D1 binding `DB` (no connection string).
# DATABASE_URL is only used by the optional legacy Postgres helper scripts
# (e.g. `just users`) — leave it as-is or remove it if you don't use them.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/demoify"

# Better Auth signing secret. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL Better Auth uses to build callback/cookie URLs.
BETTER_AUTH_URL="http://localhost:3000"

# Public app URL exposed to the browser (used for absolute links/redirects).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Optional — social login. Each provider is enabled only when both of its
# values are present.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Optional — Cloudflare R2 (song uploads). Uploads are disabled until all
# five values are set.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""

# ---------------------------------------------------------------------------
# Optional — Stripe (credit purchases, tips, Connect payouts). Every payment
# surface needs BOTH this key AND CREDITS_ENABLED != "false" (the master
# switch below) — the key alone enables nothing.
#
# Locally, use a TEST key (sk_test_…) only; test keys cannot create real
# charges, and the webhook rejects events whose livemode doesn't match the
# key. STRIPE_WEBHOOK_SECRET comes from `stripe listen --forward-to
# localhost:3000/api/credits/webhook` — note it prints a DIFFERENT whsec_ per
# listen session, so re-copy it each time. Test card: 4242 4242 4242 4242.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# ---------------------------------------------------------------------------
# Optional — Resend (transactional email: verification, password reset, email
# change). Unset means sendEmail() logs a warning and no-ops, so those flows
# silently go nowhere. Fine locally; NOT fine in production.
# EMAIL_FROM must be on a Resend-verified domain.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM="Demoify <noreply@demoify.app>"

# ---------------------------------------------------------------------------
# Email-verification write-gate. When on, accounts with an unverified email are
# read-only: they can browse and play, but not upload, comment, like, or create
# an artist profile.
#
#   "true"  — always enforce
#   "false" — never enforce
#   unset   — enforce in production only (fails closed where it matters)
#
# Deliberately independent of RESEND_API_KEY: the gate must not switch itself
# off just because email delivery broke. Set to "true" locally to exercise the
# production path (you'll also want RESEND_API_KEY, or you can't verify).
# ---------------------------------------------------------------------------
REQUIRE_EMAIL_VERIFICATION=""

# ---------------------------------------------------------------------------
# Optional — Cloudflare Turnstile (bot check on signup, verification resend and
# password reset). Both values required; unset disables the captcha entirely.
# The site key is public (it ships to the browser); the secret key is not.
# Always-passing test keys for local dev:
#   site   1x00000000000000000000AA
#   secret 1x0000000000000000000000000000000AA
# ---------------------------------------------------------------------------
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# The MASTER payments switch. On by default (uploads cost credits). Set to
# "false" to make uploads free and unlimited, hide all credit UI, AND disable
# every Stripe surface (credit checkout, tips, Connect onboarding) regardless
# of whether STRIPE_SECRET_KEY is set — useful when you self-host your own
# storage and don't want to meter uploads. The Stripe webhook alone ignores
# this flag, so in-flight checkouts still fulfil if you flip it off.
# ---------------------------------------------------------------------------
CREDITS_ENABLED="true"

# ---------------------------------------------------------------------------
# Optional — platform admin. Comma-separated emails of users allowed to manage
# coupons and gift credits at /admin. Leave unset to disable the section for
# everyone. See docs/admin.md.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=""

# ---------------------------------------------------------------------------
# Optional — Federation. Submit this instance's public tracks to a central hub
# (e.g. demoify.app) so they appear in its shared Explore feed. Both values are
# required to enable pushing; the hub operator issues you a token.
# ---------------------------------------------------------------------------
FEDERATION_HUB_URL=""
FEDERATION_TOKEN=""

# Set to "true" only on a hub instance that should ACCEPT track submissions from
# other instances and show approved ones in its own Explore.
FEDERATION_HUB_ENABLED="false"

# ---------------------------------------------------------------------------
# Optional — version label shown in the site footer. CI sets this automatically
# on deploy (and tags the commit to match); leave it unset locally (shows "dev").
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_VERSION=""
