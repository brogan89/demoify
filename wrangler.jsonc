{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "demoify",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-06-24",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		// Self-reference required by OpenNext caching; name must match "name" above.
		{ "binding": "WORKER_SELF_REFERENCE", "service": "demoify" }
	],
	"images": {
		"binding": "IMAGES"
	},

	// Cloudflare Workers Observability — enables real-time logs, error traces,
	// and the Logpush integration for long-term log storage.
	// Docs: https://developers.cloudflare.com/workers/observability/
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1.0,   // Log 100% of requests in Workers Logs
		// Set to <1.0 for production at scale (e.g. 0.1 = 10%)
		"tail_sampling_rate": 1.0,    // 100% available via `wrangler tail`
		"logpush": false              // Toggle to true and configure Logpush job
		                              // to send logs to R2, S3, Datadog, etc.
		                              // Setup: wrangler logpush create --dataset workers_trace_events
	},

	// Cloudflare D1 (SQLite) — the app database. Bound as `env.DB` (see src/lib/db.ts).
	// Create with: npx wrangler d1 create demoify
	// then paste the printed database_id below (replaces <D1_DATABASE_ID>).
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "demoify",
			"database_id": "528fd335-23b4-4922-9e44-c83e94d50bd9",
			"migrations_dir": "migrations"
		}
	],

	// Cloudflare Rate Limiting — per-colo counters, no storage cost, no D1 round-trip.
	// Bound as env.RL_* (see src/lib/rate-limit.ts). `namespace_id` is just a
	// developer-chosen string, and `period` may only be 10 or 60 (seconds).
	// Fully simulated by miniflare under `next dev`, so no provisioning is needed.
	// After editing this list run `npm run cf-typegen` to refresh cloudflare-env.d.ts.
	"ratelimits": [
		{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
		{ "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
		{ "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
		// Unauthenticated public writes (launch-updates email capture), keyed by
		// IP. Its own bucket rather than sharing RL_AUTH: otherwise a visitor
		// mashing the subscribe button would throttle their own ability to log in.
		{ "name": "RL_PUBLIC", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
	],

	// Non-secret config. Secrets (BETTER_AUTH_SECRET, STRIPE_*, R2_*, RESEND_API_KEY,
	// TURNSTILE_SECRET_KEY) are set via `wrangler secret put` / CI, NOT here.
	// No DATABASE_URL — D1 is a binding.
	"vars": {
		"BETTER_AUTH_URL": "https://demoify.app",
		"FEDERATION_HUB_ENABLED": "true",

		// Turnstile *site* key — public by design (it ships to the browser).
		// The matching secret key is a Worker secret. Leave "" to disable the
		// captcha entirely (the Better Auth plugin is only registered when the
		// secret is present — see src/lib/auth.ts).
		"TURNSTILE_SITE_KEY": "",

		// Outgoing mail identity. Not a secret — it's just an address, and having
		// it in the repo documents which sender the app expects.
		//
		// The subdomain is deliberate. Resend needs SPF on whatever domain it
		// sends from, and Cloudflare Email Routing owns the SPF record on the
		// root (it handles INBOUND mail for legal@demoify.app). A domain may have
		// only ONE SPF record, so putting both on the root means hand-merging two
		// includes and silently breaking delivery if it's wrong. Sending from
		// send.demoify.app gives Resend its own records and leaves the root
		// untouched. It also isolates sending reputation.
		//
		// Must match a Resend-VERIFIED domain — src/lib/email.ts falls back to
		// noreply@demoify.app if this is unset, which would not be verified.
		"EMAIL_FROM": "Demoify <noreply@send.demoify.app>",

		// Email-verification write-gate. Unset ⇒ ON in production, OFF in dev.
		// Deliberately pinned to "false" for the FIRST deploy of this feature so
		// migration 0016 (grandfathering) and the new UI ship inert; flip to
		// "true" in a follow-up deploy to actually enforce. Flipping back is the
		// rollback — there is no data migration to undo.
		"REQUIRE_EMAIL_VERIFICATION": "false",

		// Credit economy. Unset ⇒ ON (src/lib/credits.ts reads `!== "false"`), so
		// this must be pinned, not omitted: the Sep 2026 launch is free and the
		// launch copy says so out loud. "false" makes uploads free and unlimited
		// and hides all credit UI (balance pill, buy-credits page, cost labels).
		// Flip to "true" only when Stripe goes live — and update the public copy
		// in the same deploy, because "free" is load-bearing in the launch posts.
		"CREDITS_ENABLED": "false"
	},

	// --- Cron triggers for periodic analytics aggregation ---
	// Uncomment to enable. Set secrets via wrangler secret put.
	// "triggers": {
	//   "crons": ["0 6 * * *"]  // Daily at 06:00 UTC — analytics snapshot + Stripe sync
	// },

	// --- Custom domain (zone demoify.app active on Cloudflare) -------------
	"routes": [
		{ "pattern": "demoify.app", "custom_domain": true }
	],

	// --- Dev-only: point `next dev` at production data --------------------
	// Selected by `npm run dev:remote` (sets DEV_REMOTE_DB=1, which makes
	// next.config.ts pass `environment: "remote"` to getPlatformProxy).
	// The `remote: true` D1 binding resolves to the live Cloudflare database
	// instead of the empty local emulation, so pages like /explore render
	// real data. Writes are blocked by a read-only guard in src/lib/db.ts.
	// Requires `wrangler login`. Not used by `wrangler deploy` (top-level only).
	// Named environments do NOT inherit bindings, so mirror what dev needs.
	"env": {
		"remote": {
			// Mirrored from the top level so `dev:remote` renders the same
			// credit-free UI production serves.
			"vars": {
				"BETTER_AUTH_URL": "http://localhost:3000",
				"CREDITS_ENABLED": "false"
			},
			"images": { "binding": "IMAGES" },
			// Mirrored from the top level — named environments inherit nothing.
			// Without this, src/lib/rate-limit.ts finds no binding and fails open.
			"ratelimits": [
				{ "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_WRITE", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } },
				{ "name": "RL_UPLOAD", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
				{ "name": "RL_PUBLIC", "namespace_id": "1004", "simple": { "limit": 5, "period": 60 } }
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "demoify",
					"database_id": "528fd335-23b4-4922-9e44-c83e94d50bd9",
					"migrations_dir": "migrations",
					"remote": true
				}
			]
		}
	}
}